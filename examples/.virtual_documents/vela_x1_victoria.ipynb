def sort_spectrum_by_energy(energy, values, errors, bin_width=None):
    idx = np.argsort(energy)

    energy = energy[idx]
    values = values[idx]
    errors = errors[idx]

    if bin_width is not None:
        bin_width = bin_width[idx]
        return energy, values, errors, bin_width

    return energy, values, errors


